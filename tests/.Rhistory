library(rebus)
print("Hello \U1F30D")
?paste()
dplyr::glimpse(babynames)
setwd("~/GitHub/araxne/tests")
# Load necessary library
library(ggplot2)
# 1. Read and clean the first dataset (Rhyming)
statsy <- read.table(file = "stats.txt",
header = TRUE,
sep = ":",
dec = ".",
encoding = "UTF-8",
strip.white = TRUE,
stringsAsFactors = FALSE)
statsy$Wynik <- as.numeric(as.character(statsy$Wynik))
statsy$Grupa <- "Pary rymujące się" # Add a grouping variable
# 2. Read and clean the second dataset (Non-rhyming)
antystatsy <- read.table(file = "anti-stats.txt",
header = TRUE,
sep = ":",
dec = ".",
encoding = "UTF-8",
strip.white = TRUE,
stringsAsFactors = FALSE)
antystatsy$Wynik <- as.numeric(as.character(antystatsy$Wynik))
antystatsy$Grupa <- "Pary nierymujące się" # Add a grouping variable
# 3. Combine the necessary columns into one dataframe for ggplot
# This makes it easy to plot side-by-side boxplots
combined_data <- rbind(
data.frame(Wynik = statsy$Wynik, Grupa = statsy$Grupa),
data.frame(Wynik = antystatsy$Wynik, Grupa = antystatsy$Grupa)
)
# Lock in the order of the categories so "Pary rymujące się" appears first
combined_data$Grupa <- factor(combined_data$Grupa, levels = c("Pary rymujące się", "Pary nierymujące się"))
# 4. Generate the double boxplot with the custom dark theme
ggplot(combined_data, aes(x = Grupa, y = Wynik)) +
# Boxplot aesthetics: orange fill, light grey borders, and orange outliers
geom_boxplot(fill = "orange",, alpha = 0.7, color = "lightgrey", outlier.color = "lightgrey") +
scale_y_continuous(limits = c(0, 100)) +
labs(title = "Porównanie Rymowalności",
x = NULL, # Removes the x-axis label since the categories are self-explanatory
y = "Rymowalność") +
theme_minimal() +
theme(
# Backgrounds: Off-black
plot.background = element_rect(fill = "#1e1e1e", color = NA),
panel.background = element_rect(fill = "#1e1e1e", color = NA),
# Text: Light grey
text = element_text(color = "lightgrey"),
axis.text = element_text(color = "lightgrey"),
axis.title = element_text(color = "lightgrey", face = "bold"),
plot.title = element_text(color = "lightgrey", face = "bold", hjust = 0.5),
# Lines: Light grey axes, muted grey grid lines to not overpower the data
axis.line = element_line(color = "lightgrey"),
panel.grid.major = element_line(color = "#3a3a3a", linewidth = 0.5),
panel.grid.minor = element_line(color = "#2a2a2a", linewidth = 0.25)
)

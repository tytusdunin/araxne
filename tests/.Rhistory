print("Hello \U1F30D")
?paste()
dplyr::glimpse(babynames)
statsy <- read.table(file = "stats.txt",
header = TRUE,
sep = ":",
dec = ".",
encoding = "UTF-8",   # Spróbuj UTF-8 zamiast windows-1250 jeśli znaki są błędne
strip.white = TRUE,   # Usuwa spacje wokół separatorów
stringsAsFactors = FALSE)
setwd("~/GitHub/araxne")
statsy <- read.table(file = "stats.txt",
header = TRUE,
sep = ":",
dec = ".",
encoding = "UTF-8",   # Spróbuj UTF-8 zamiast windows-1250 jeśli znaki są błędne
strip.white = TRUE,   # Usuwa spacje wokół separatorów
stringsAsFactors = FALSE)
# Sprawdź typ danych przed wykresem
statsy$Wynik <- as.numeric(as.character(statsy$Wynik))
class(statsy$Wynik)
boxplot(statsy$Wynik, data = statsy, ylim = c(0,100), main  = "Pary rymujące się", ylab = "Rymowalność")
antystatsy <- read.table(file = "anti-stats.txt", header = TRUE, sep = ":", dec = ".", encoding = 'windows-1250')
antystatsy$Wynik <- as.numeric(as.character(antystatsy$Wynik))
boxplot(antystatsy$Wynik, data = statsy, ylim = c(0,100), main  = "Pary nierymujące się", ylab = "Rymowalność")
??boxplot
